          },
          "aplica": {
            "type": "boolean",
            "title": "Aplica"
          },
          "total": {
            "type": "string",
            "title": "Total"
          },
          "motivos": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Motivos"
          }
        },
        "type": "object",
        "required": [
