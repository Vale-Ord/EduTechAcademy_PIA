# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repositorio.
POSTGRES_USER=edutech
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=edutech
# Dentro de docker compose el host de la base es "db"
DATABASE_URL=postgresql://edutech:cambia-esta-clave@db:5432/edutech
SEED_ON_STARTUP=true
APP_ENV=development
APP_PORT=8000
